# Copy this file to .env.local and fill in whichever key(s) you have. Never
# commit .env.local. Keys are only ever read server-side (inside
# app/api/*/route.js) — never sent to the browser.
#
# MedLens tries providers in this order: Claude first, then Gemini, then
# falls back to a built-in offline pattern-matcher/template so the app is
# always usable even with zero keys configured.

# ---------- Option 1: Anthropic Claude (paid, best quality) ----------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model used for extraction/summary/ask calls.
# Check https://docs.claude.com/en/docs/about-claude/models for the current
# model ID string — the default below may not be the latest at deploy time.
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- Option 2: Google Gemini (has a genuine free tier) ----------
# Get a free key in about a minute at https://aistudio.google.com/app/apikey
# — no billing setup required for the Flash models. Used automatically
# whenever ANTHROPIC_API_KEY is missing or fails.
#
# Note: a Gemini app / "Gemini Advanced" *subscription* is the consumer
# chat product and is a different thing from an API key — it does not by
# itself unlock this endpoint. You still need a key from AI Studio (the
# free tier is enough) or a billing-enabled Google Cloud project.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the Gemini model. Google retires model versions on a
# rolling basis (see https://ai.google.dev/gemini-api/docs/models) — check
# that page if the default below has been sunset.
GEMINI_MODEL=gemini-3-flash-preview

# ---------- Optional: simple demo-grade access passcode ----------
# This is NOT real authentication/authorization — it's a lightweight gate so
# the app isn't wide open when deployed to a public URL for a demo/judging
# session. Uses the NEXT_PUBLIC_ prefix because it is only ever a
# non-secret demo gate, never treated as a real credential — leave unset to
# allow any name to sign in with no code.
NEXT_PUBLIC_DEMO_ACCESS_CODE=medlens-demo
